{
  "$comment": "One source reference. Either a book page (with optional section) or a course slide, each with a verbatim anchor of 6 to 15 words, or the marker that the reasoning is ours.",
  "oneOf": [
    {
      "type": "object",
      "required": ["boek", "anker"],
      "additionalProperties": false,
      "properties": {
        "boek": {"type": "integer", "minimum": 5, "maximum": 255},
        "sectie": {"type": "string", "pattern": "^(1[0-4]|[1-9])(\\.[0-9]{1,2})?$"},
        "anker": {"type": "string", "minLength": 12}
      }
    },
    {
      "type": "object",
      "required": ["slide", "anker"],
      "additionalProperties": false,
      "properties": {
        "slide": {"type": "integer", "minimum": 1, "maximum": 322},
        "anker": {"type": "string", "minLength": 12}
      }
    },
    {
      "type": "object",
      "required": ["afgeleid"],
      "additionalProperties": false,
      "properties": {"afgeleid": {"const": true}}
    }
  ]
}
