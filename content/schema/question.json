{
  "$comment": "One question. A bank file content/bank/Uxx.json and a batch file content/questions/Uxx/batch-nn.json both hold {unit, vragen: [question]}.",
  "type": "object",
  "required": ["id", "unit", "pagina", "type", "soort", "stam", "media", "opties", "correct", "uitleg", "bronnen", "cbr_onderwerp", "moeilijkheid", "tier", "tags", "versie", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^U[0-9]{2}-Q[0-9]{3}$"},
    "unit": {"type": "string", "pattern": "^U[0-9]{2}$"},
    "pagina": {"type": "string", "pattern": "^U[0-9]{2}-P[0-9]{2}$"},
    "type": {"enum": ["ja_nee", "meerkeuze", "meervoudig", "invul", "hotspot", "volgorde", "reeks"]},
    "soort": {"enum": ["inzicht", "kennis"]},
    "stam": {"type": "string", "minLength": 15},
    "media": {"oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["scene"], "additionalProperties": false, "properties": {"scene": {"type": "string", "pattern": "^S-"}}},
      {"type": "object", "required": ["bord"], "additionalProperties": false, "properties": {"bord": {"type": "string"}}},
      {"type": "object", "required": ["borden"], "additionalProperties": false, "properties": {"borden": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string"}}}},
      {"type": "object", "required": ["reeks"], "additionalProperties": false, "properties": {"reeks": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "string", "pattern": "^S-"}}}}
    ]},
    "opties": {"type": "array", "items": {
      "type": "object", "required": ["id", "tekst", "feedback"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,12}$"},
        "tekst": {"type": "string", "minLength": 1},
        "feedback": {"type": "string", "minLength": 20},
        "fouttype": {"oneOf": [{"type": "null"}, {"enum": ["niet_geweten", "verkeerd_gelezen", "verkeerd_toegepast"]}]}
      }}},
    "correct": {"oneOf": [
      {"type": "array", "minItems": 1, "items": {"type": "string"}},
      {"type": "object", "required": ["getal", "eenheid"], "additionalProperties": false, "properties": {
        "getal": {"type": "number"}, "eenheid": {"type": "string"}, "tolerantie": {"type": "number", "minimum": 0}}}
    ]},
    "uitleg": {"type": "object", "required": ["regel", "waarom", "valkuil"], "additionalProperties": false, "properties": {
      "regel": {"type": "string", "minLength": 15},
      "waarom": {"type": "string", "minLength": 15},
      "valkuil": {"type": "string", "minLength": 10},
      "onthoud": {"type": "string", "minLength": 5}
    }},
    "bronnen": {"type": "array", "minItems": 1, "items": {"$ref": "bron.json"}},
    "cbr_onderwerp": {"enum": ["gebruik_van_de_weg", "voorrang_en_voor_laten_gaan", "bijzondere_wegen_weggebruikers_manoeuvres", "veilig_rijden_en_noodsituaties", "verkeerstekens_en_aanwijzingen", "verantwoorde_deelname_en_milieu", "wetgeving", "voertuigkennis"]},
    "moeilijkheid": {"type": "integer", "minimum": 1, "maximum": 3},
    "tier": {"enum": ["must", "should", "nice"]},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "reserve": {"type": "boolean"},
    "gegenereerd": {"type": "boolean"},
    "versie": {"type": "integer", "minimum": 1},
    "status": {"enum": ["concept", "gecheckt", "goedgekeurd"]},
    "checker": {"type": "object", "$comment": "free-form notes from the checker pass: quoted evidence per question"}
  }
}
